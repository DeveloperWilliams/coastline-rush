* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.fbx binary
*.png binary
*.wav binary
*.ttf binary
# Unity serializes empty YAML fields with a trailing space.
*.meta whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
# Retain the original whitespace in third-party license texts.
*.txt whitespace=-blank-at-eol
